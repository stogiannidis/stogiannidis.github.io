---
---
<!--
  Research constellations.
  Idle state: calm clusters for vision, language, time, space, and embodiment.
-->
<canvas id="bg-canvas" transition:persist="bg-canvas"></canvas>

<style>
  #bg-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
  }
</style>

<script>
  (function () {
    const canvas = document.getElementById('bg-canvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const initKey = '__stogiannidisResearchConstellationBg';
    if (window[initKey]) return;
    window[initKey] = true;

    const TAU = Math.PI * 2;

    const CLUSTER_DEFS = [
      { id: 'vision', fx: 0.17, fy: 0.24, radius: 72, nodes: 7, drift: 16, markerSize: 13, opacity: 1 },
      { id: 'language', fx: 0.83, fy: 0.29, radius: 80, nodes: 8, drift: 18, markerSize: 14, opacity: 1 },
      { id: 'time', fx: 0.21, fy: 0.77, radius: 78, nodes: 7, drift: 17, markerSize: 13, opacity: 0.98 },
      { id: 'space', fx: 0.81, fy: 0.75, radius: 80, nodes: 8, drift: 18, markerSize: 14, opacity: 1 },
      { id: 'embodiment', fx: 0.54, fy: 0.57, radius: 62, nodes: 6, drift: 12, markerSize: 12, opacity: 0.9 },
    ];

    const BRIDGES = [
      { from: 'vision', to: 'language', bend: -0.08 },
      { from: 'vision', to: 'space', bend: -0.06 },
      { from: 'language', to: 'time', bend: 0.08 },
      { from: 'space', to: 'time', bend: -0.08 },
      { from: 'vision', to: 'embodiment', bend: 0.05 },
      { from: 'language', to: 'embodiment', bend: -0.05 },
    ];

    let width = window.innerWidth;
    let height = window.innerHeight;
    let animationId = 0;
    let lastFrameTime = 0;
    let clusters = [];

    // 4D Spatial Field Easter Egg state
    const pointer = {
      x: width * 0.5,
      y: height * 0.45,
      active: false,
      holding: false,
      locked: false,
      strength: 0, // 0 = normal, 1 = full 4D singularity vortex
    };

    const CLUSTER_LABELS = {
      vision: '4D.VISION // TENSOR',
      language: '4D.LANG // SEMANTIC',
      time: '4D.TIME // TEMPORAL',
      space: '4D.SPACE // MANIFOLD',
      embodiment: '4D.EMBODIED // ACT',
    };

    // 4D Tesseract (Hypercube) vertices in [-1, 1]^4 and edges
    const TESSERACT_VERTS = [];
    for (let i = 0; i < 16; i++) {
      TESSERACT_VERTS.push([
        (i & 1) ? 1 : -1,
        (i & 2) ? 1 : -1,
        (i & 4) ? 1 : -1,
        (i & 8) ? 1 : -1,
      ]);
    }
    const TESSERACT_EDGES = [];
    for (let i = 0; i < 16; i++) {
      for (let j = i + 1; j < 16; j++) {
        const diff = i ^ j;
        if (diff && !(diff & (diff - 1))) {
          TESSERACT_EDGES.push([i, j]);
        }
      }
    }

    const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reduceMotion = reduceMotionQuery.matches;

    function isCompactViewport() {
      return width < 768;
    }

    function getViewportScale() {
      return isCompactViewport() ? Math.max(0.58, width / 768) : 1;
    }

    function rgba(rgb, alpha) {
      return 'rgba(' + rgb + ', ' + alpha + ')';
    }

    function isDark() {
      return document.documentElement.getAttribute('data-theme') === 'dark';
    }

    function getThemes() {
      if (isDark()) {
        return {
          vision: { main: '0, 245, 212', accent: '255, 42, 133', outline: '0, 180, 160' },
          language: { main: '255, 42, 133', accent: '167, 139, 250', outline: '200, 30, 110' },
          time: { main: '167, 139, 250', accent: '0, 245, 212', outline: '123, 44, 191' },
          space: { main: '0, 245, 212', accent: '167, 139, 250', outline: '0, 180, 160' },
          embodiment: { main: '255, 42, 133', accent: '0, 245, 212', outline: '180, 40, 120' },
        };
      }

      return {
        vision: { main: '114, 9, 183', accent: '201, 24, 74', outline: '90, 24, 154' },
        language: { main: '201, 24, 74', accent: '114, 9, 183', outline: '164, 19, 60' },
        time: { main: '123, 44, 191', accent: '247, 37, 133', outline: '90, 24, 154' },
        space: { main: '114, 9, 183', accent: '201, 24, 74', outline: '90, 24, 154' },
        embodiment: { main: '201, 24, 74', accent: '114, 9, 183', outline: '164, 19, 60' },
      };
    }

    function onReducedMotionChange(event) {
      reduceMotion = event.matches;
      createClusters();
      if (reduceMotion) {
        stop();
        render(performance.now());
      } else {
        start();
      }
    }

    function createNode(definition, nodeIndex, totalNodes, scale) {
      return {
        angle: (nodeIndex / totalNodes) * TAU + Math.random() * 0.45,
        radial: definition.radius * scale * (0.42 + Math.random() * 0.56),
        orbitSpeed: (0.22 + Math.random() * 0.2) * (Math.random() < 0.5 ? -1 : 1),
        pulsePhase: Math.random() * TAU,
        pulseSpeed: 0.9 + Math.random() * 1.2,
        size: (1.8 + Math.random() * 2.7) * (0.85 + scale * 0.15),
      };
    }

    function createClusters() {
      const scale = getViewportScale();
      clusters = CLUSTER_DEFS.map((definition) => {
        const nodeCount = isCompactViewport() ? Math.max(4, definition.nodes - 2) : definition.nodes;
        const scaledDef = {
          ...definition,
          radius: definition.radius * scale,
          drift: definition.drift * scale,
          markerSize: definition.markerSize * Math.max(0.75, scale),
          nodes: nodeCount,
        };
        const nodes = [];
        for (let i = 0; i < nodeCount; i++) {
          nodes.push(createNode(definition, i, nodeCount, scale));
        }

        return {
          ...scaledDef,
          phaseX: Math.random() * TAU,
          phaseY: Math.random() * TAU,
          driftSpeedX: 0.2 + Math.random() * 0.14,
          driftSpeedY: 0.16 + Math.random() * 0.14,
          nodes,
          positions: [],
          x: width * definition.fx,
          y: height * definition.fy,
          attention: 0,
          theme: null,
        };
      });
    }

    function resizeCanvas(force) {
      const nextWidth = window.innerWidth;
      const nextHeight = window.innerHeight;
      // Ignore small height-only shifts caused by mobile browser address bars hiding/showing
      if (!force && nextWidth === width && Math.abs(nextHeight - height) < 120) {
        return;
      }
      const widthChanged = nextWidth !== width;
      width = nextWidth;
      height = nextHeight;
      canvas.width = width;
      canvas.height = height;
      if (widthChanged) {
        createClusters();
      }
      if (reduceMotion) {
        render(performance.now());
      }
    }

    function updateClusters(time) {
      const themes = getThemes();
      const targetStrength = (pointer.holding || pointer.locked) ? 1 : 0;
      pointer.strength += (targetStrength - pointer.strength) * 0.08;
      if (pointer.strength < 0.002 && targetStrength === 0) pointer.strength = 0;

      clusters.forEach((cluster, clusterIdx) => {
        cluster.theme = themes[cluster.id];

        const drift = reduceMotion ? 0 : cluster.drift;
        const baseX = width * cluster.fx + Math.sin(time * cluster.driftSpeedX + cluster.phaseX) * drift;
        const baseY = height * cluster.fy + Math.cos(time * cluster.driftSpeedY + cluster.phaseY) * drift;

        // Pull cluster centers slightly toward singularity when 4D field is active
        const pull = pointer.strength * 0.28;
        cluster.x = baseX * (1 - pull) + pointer.x * pull;
        cluster.y = baseY * (1 - pull) + pointer.y * pull;

        if (pointer.active) {
          const dx = pointer.x - cluster.x;
          const dy = pointer.y - cluster.y;
          const dist = Math.hypot(dx, dy);
          const prox = Math.max(0, 1 - dist / 300);
          cluster.attention = Math.min(1, prox * 0.85 + pointer.strength * 0.65);
        } else {
          cluster.attention = pointer.strength * 0.6;
        }

        cluster.positions = cluster.nodes.map((node, nodeIdx) => {
          const pulse = reduceMotion ? 0 : Math.sin(time * node.pulseSpeed + node.pulsePhase);
          const angle = node.angle + (reduceMotion ? 0 : time * node.orbitSpeed * 0.12);
          const radial = node.radial + pulse * 4.2;
          const homeX = cluster.x + Math.cos(angle) * radial;
          const homeY = cluster.y + Math.sin(angle) * radial;

          // 4D Orbital Vortex target position around pointer
          const orbitShell = 52 + clusterIdx * 24 + (nodeIdx % 3) * 14;
          const vortexAngle = node.angle + time * (1.4 + clusterIdx * 0.28) * (clusterIdx % 2 === 0 ? 1 : -1);
          const wTilt = Math.cos(time * 1.1 + nodeIdx + clusterIdx) * 0.38;
          const vortexX = pointer.x + Math.cos(vortexAngle) * orbitShell;
          const vortexY = pointer.y + Math.sin(vortexAngle) * orbitShell * (0.68 + wTilt);

          const s = pointer.strength;
          const x = homeX * (1 - s) + vortexX * s;
          const y = homeY * (1 - s) + vortexY * s;

          let nodeProximity = 0;
          if (pointer.active) {
            const nd = Math.hypot(pointer.x - x, pointer.y - y);
            nodeProximity = Math.max(0, 1 - nd / 210);
          }

          return {
            x,
            y,
            size: node.size + pulse * 0.16 + s * 0.8,
            pulse,
            proximity: Math.min(1, nodeProximity + s * 0.55),
          };
        });
      });
    }

    function getCluster(id) {
      for (let i = 0; i < clusters.length; i++) {
        if (clusters[i].id === id) return clusters[i];
      }
      return null;
    }

    function drawClusterHalo(cluster) {
      const radius = cluster.radius * (1.42 + cluster.attention * 0.18);
      const gradient = ctx.createRadialGradient(cluster.x, cluster.y, cluster.radius * 0.12, cluster.x, cluster.y, radius);
      const theme = cluster.theme;

      gradient.addColorStop(0, rgba(theme.main, 0.035 * cluster.opacity + cluster.attention * 0.08));
      gradient.addColorStop(0.48, rgba(theme.accent, 0.018 * cluster.opacity + cluster.attention * 0.04));
      gradient.addColorStop(1, rgba(theme.main, 0));

      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(cluster.x, cluster.y, radius, 0, TAU);
      ctx.fill();
    }

    function drawBridge(bridge) {
      const from = getCluster(bridge.from);
      const to = getCluster(bridge.to);
      if (!from || !to) return;

      const emphasis = Math.max(from.attention, to.attention);
      const dx = to.x - from.x;
      const dy = to.y - from.y;
      const controlX = (from.x + to.x) / 2 - dy * bridge.bend;
      const controlY = (from.y + to.y) / 2 + dx * bridge.bend;

      ctx.save();
      ctx.setLineDash(emphasis > 0.08 ? [] : [3, 10]);
      ctx.lineWidth = 0.9 + emphasis * 1.2;
      ctx.strokeStyle = rgba(from.theme.outline, 0.04 + emphasis * 0.12);
      ctx.beginPath();
      ctx.moveTo(from.x, from.y);
      ctx.quadraticCurveTo(controlX, controlY, to.x, to.y);
      ctx.stroke();
      ctx.restore();
    }

    function drawIdleMesh(cluster) {
      const points = cluster.positions;
      if (!points.length) return;

      ctx.save();
      ctx.setLineDash(cluster.attention > 0.14 ? [] : [2, 6]);
      ctx.lineWidth = 0.8 + cluster.attention * 0.45;
      ctx.strokeStyle = rgba(cluster.theme.outline, 0.07 * cluster.opacity + cluster.attention * 0.07);
      ctx.beginPath();

      for (let i = 0; i < points.length; i++) {
        const point = points[i];
        const next = points[(i + 1) % points.length];
        ctx.moveTo(point.x, point.y);
        ctx.lineTo(next.x, next.y);

        if (i % 2 === 0) {
          ctx.moveTo(cluster.x, cluster.y);
          ctx.lineTo(point.x, point.y);
        }
      }

      ctx.stroke();
      ctx.restore();
    }

    function drawNodes(cluster) {
      for (let i = 0; i < cluster.positions.length; i++) {
        const point = cluster.positions[i];
        const proximity = point.proximity || 0;
        const radius = point.size + proximity * 1.35;
        const fillColor = proximity > 0.45 ? cluster.theme.accent : cluster.theme.main;
        const alpha = (0.18 + (point.pulse + 1) * 0.045 + cluster.attention * 0.06 + proximity * 0.42) * cluster.opacity;

        ctx.fillStyle = rgba(fillColor, alpha);
        ctx.beginPath();
        ctx.arc(point.x, point.y, radius, 0, TAU);
        ctx.fill();

        ctx.strokeStyle = rgba(cluster.theme.outline, 0.08 + cluster.attention * 0.08 + proximity * 0.22);
        ctx.lineWidth = 0.75;
        ctx.beginPath();
        ctx.arc(point.x, point.y, radius + 1.5, 0, TAU);
        ctx.stroke();

        // Draw live 4D tensor threads to cursor when close or in vortex mode
        if (pointer.active && proximity > 0.28) {
          ctx.save();
          ctx.strokeStyle = rgba(cluster.theme.main, (proximity - 0.25) * 0.22);
          ctx.lineWidth = 0.7 + pointer.strength * 0.4;
          ctx.beginPath();
          ctx.moveTo(pointer.x, pointer.y);
          ctx.lineTo(point.x, point.y);
          ctx.stroke();
          ctx.restore();
        }
      }

      // HUD telemetry label above attentive clusters
      if (cluster.attention > 0.35) {
        const a = Math.min(0.85, (cluster.attention - 0.35) * 1.3);
        ctx.save();
        ctx.font = '600 10px "JetBrains Mono", monospace';
        ctx.fillStyle = rgba(cluster.theme.main, a);
        ctx.textAlign = 'center';
        const label = CLUSTER_LABELS[cluster.id] || cluster.id.toUpperCase();
        ctx.fillText('[' + label + ']', cluster.x, cluster.y - cluster.markerSize - 14);
        ctx.restore();
      }
    }

    function draw4DFieldHUD(time) {
      if (!pointer.active && pointer.strength < 0.01) return;

      const cyan = isDark() ? '0, 245, 212' : '114, 9, 183';
      const magenta = isDark() ? '255, 42, 133' : '201, 24, 74';
      const s = pointer.strength;
      const baseAlpha = pointer.active ? 0.28 + s * 0.55 : s * 0.65;

      ctx.save();
      ctx.translate(pointer.x, pointer.y);

      // Outer rotating holographic reticle rings
      ctx.strokeStyle = rgba(cyan, baseAlpha * 0.55);
      ctx.lineWidth = 1;
      ctx.setLineDash([5, 7]);
      ctx.beginPath();
      ctx.arc(0, 0, 26 + s * 38, time * 0.9, time * 0.9 + TAU);
      ctx.stroke();

      if (s > 0.04) {
        ctx.strokeStyle = rgba(magenta, s * 0.45);
        ctx.setLineDash([10, 6]);
        ctx.beginPath();
        ctx.arc(0, 0, 52 + s * 64, -time * 1.2, -time * 1.2 + TAU);
        ctx.stroke();

        // Project rotating 4D Tesseract (Hypercube) in XW, YW, ZW planes
        const scale4D = 16 + s * 26;
        const aXW = time * 1.7;
        const aYW = time * 1.25;
        const aZW = time * 0.95;
        const cosXW = Math.cos(aXW), sinXW = Math.sin(aXW);
        const cosYW = Math.cos(aYW), sinYW = Math.sin(aYW);
        const cosZW = Math.cos(aZW), sinZW = Math.sin(aZW);

        const projected = TESSERACT_VERTS.map((v) => {
          let x = v[0], y = v[1], z = v[2], w = v[3];
          // Rotate XW
          let nx = x * cosXW - w * sinXW;
          let nw = x * sinXW + w * cosXW;
          x = nx; w = nw;
          // Rotate YW
          let ny = y * cosYW - w * sinYW;
          nw = y * sinYW + w * cosYW;
          y = ny; w = nw;
          // Rotate XY/ZW
          let nz = z * cosZW - x * sinZW;
          nx = z * sinZW + x * cosZW;
          z = nz; x = nx;

          const wPersp = 1 / (2.4 - w * 0.55);
          const zPersp = 1 / (2.6 - z * 0.45);
          const p = wPersp * zPersp * 2.2 * scale4D;
          return [x * p, y * p, w];
        });

        ctx.setLineDash([]);
        ctx.lineWidth = 1.1;
        for (let i = 0; i < TESSERACT_EDGES.length; i++) {
          const e = TESSERACT_EDGES[i];
          const p1 = projected[e[0]];
          const p2 = projected[e[1]];
          const wAvg = (p1[2] + p2[2]) * 0.5;
          ctx.strokeStyle = rgba(wAvg > 0 ? cyan : magenta, s * (0.35 + (wAvg + 1) * 0.18));
          ctx.beginPath();
          ctx.moveTo(p1[0], p1[1]);
          ctx.lineTo(p2[0], p2[1]);
          ctx.stroke();
        }
      }

      // Live 4D HUD coordinate telemetry readout
      ctx.setLineDash([]);
      ctx.font = '600 10px "JetBrains Mono", monospace';
      ctx.textAlign = 'left';
      const normX = ((pointer.x / Math.max(1, width)) * 2 - 1).toFixed(2);
      const normY = (((1 - pointer.y / Math.max(1, height)) * 2) - 1).toFixed(2);
      const normW = Math.sin(time * 1.5).toFixed(2);
      const tauVal = (time % 99.9).toFixed(2);

      if (s > 0.1) {
        ctx.fillStyle = rgba(magenta, Math.min(0.95, s));
        ctx.fillText(
          pointer.locked ? '4D.TESSERACT // FIELD_LOCKED [DBL-CLICK EXIT]' : '4D.TESSERACT // SINGULARITY_ACTIVE',
          36,
          -14
        );
        ctx.fillStyle = rgba(cyan, Math.min(0.9, s));
        ctx.fillText(`x=${normX} y=${normY} w=${normW} Δt=${tauVal}s`, 36, 0);
      } else if (pointer.active) {
        ctx.fillStyle = rgba(cyan, 0.5);
        ctx.fillText(`4D.FIELD [${normX}, ${normY}, w=${normW}]`, 22, 4);
      }

      ctx.restore();
    }

    function drawVisionMarker(cluster) {
      const size = cluster.markerSize + cluster.attention * 3.2;
      ctx.save();
      ctx.translate(cluster.x, cluster.y);
      ctx.lineWidth = 1.1 + cluster.attention * 0.6;
      ctx.strokeStyle = rgba(cluster.theme.main, 0.26 + cluster.attention * 0.26);
      ctx.fillStyle = rgba(cluster.theme.main, 0.1 + cluster.attention * 0.08);
      ctx.beginPath();
      ctx.moveTo(-size, 0);
      ctx.quadraticCurveTo(0, -size * 0.72, size, 0);
      ctx.quadraticCurveTo(0, size * 0.72, -size, 0);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = rgba(cluster.theme.accent, 0.34 + cluster.attention * 0.3);
      ctx.beginPath();
      ctx.arc(0, 0, size * 0.22, 0, TAU);
      ctx.fill();
      ctx.restore();
    }

    function drawLanguageMarker(cluster) {
      const size = cluster.markerSize + cluster.attention * 3;
      const lines = [size * 1.05, size * 0.76, size * 0.92];
      ctx.save();
      ctx.translate(cluster.x, cluster.y);
      ctx.lineCap = 'round';
      for (let i = 0; i < lines.length; i++) {
        const y = (i - 1) * size * 0.42;
        ctx.strokeStyle = rgba(i === 1 ? cluster.theme.accent : cluster.theme.main, 0.2 + cluster.attention * 0.24);
        ctx.lineWidth = 1.4 + cluster.attention * 0.4;
        ctx.beginPath();
        ctx.moveTo(-lines[i] * 0.5, y);
        ctx.lineTo(lines[i] * 0.5, y);
        ctx.stroke();
      }
      ctx.restore();
    }

    function drawTimeMarker(cluster, time) {
      const size = cluster.markerSize + cluster.attention * 3.1;
      ctx.save();
      ctx.translate(cluster.x, cluster.y);
      ctx.strokeStyle = rgba(cluster.theme.main, 0.24 + cluster.attention * 0.22);
      ctx.lineWidth = 1.05 + cluster.attention * 0.45;
      ctx.beginPath();
      ctx.arc(0, 0, size, 0, TAU);
      ctx.stroke();
      ctx.strokeStyle = rgba(cluster.theme.accent, 0.28 + cluster.attention * 0.26);
      ctx.beginPath();
      ctx.arc(0, 0, size * 0.55, 0, TAU);
      ctx.stroke();
      const handAngle = reduceMotion ? -Math.PI / 4 : time * 1.3;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(Math.cos(handAngle) * size * 0.65, Math.sin(handAngle) * size * 0.65);
      ctx.stroke();
      ctx.restore();
    }

    function drawSpaceMarker(cluster) {
      const size = cluster.markerSize + cluster.attention * 3.2;
      ctx.save();
      ctx.translate(cluster.x, cluster.y);
      ctx.lineCap = 'round';
      ctx.lineWidth = 1.15 + cluster.attention * 0.45;
      ctx.strokeStyle = rgba(cluster.theme.accent, 0.28 + cluster.attention * 0.22);
      ctx.beginPath();
      ctx.moveTo(0, -size);
      ctx.lineTo(0, size * 0.84);
      ctx.stroke();
      ctx.strokeStyle = rgba(cluster.theme.main, 0.24 + cluster.attention * 0.22);
      ctx.beginPath();
      ctx.moveTo(-size * 0.92, size * 0.48);
      ctx.lineTo(size * 0.96, size * 0.48);
      ctx.stroke();
      ctx.strokeStyle = rgba(cluster.theme.outline, 0.22 + cluster.attention * 0.2);
      ctx.beginPath();
      ctx.moveTo(-size * 0.76, -size * 0.4);
      ctx.lineTo(size * 0.76, size * 0.96);
      ctx.stroke();
      ctx.restore();
    }

    function drawEmbodimentMarker(cluster) {
      const size = cluster.markerSize + cluster.attention * 2.8;
      ctx.save();
      ctx.translate(cluster.x, cluster.y);
      ctx.strokeStyle = rgba(cluster.theme.main, 0.24 + cluster.attention * 0.22);
      ctx.lineWidth = 1.1 + cluster.attention * 0.4;
      ctx.beginPath();
      ctx.moveTo(0, -size);
      ctx.lineTo(-size * 0.86, size * 0.66);
      ctx.lineTo(size * 0.86, size * 0.66);
      ctx.closePath();
      ctx.stroke();
      ctx.fillStyle = rgba(cluster.theme.accent, 0.24 + cluster.attention * 0.24);
      ctx.beginPath();
      ctx.arc(0, -size, 2.2, 0, TAU);
      ctx.arc(-size * 0.86, size * 0.66, 2.2, 0, TAU);
      ctx.arc(size * 0.86, size * 0.66, 2.2, 0, TAU);
      ctx.fill();
      ctx.restore();
    }

    function drawMarker(cluster, time) {
      switch (cluster.id) {
        case 'vision':
          drawVisionMarker(cluster);
          break;
        case 'language':
          drawLanguageMarker(cluster);
          break;
        case 'time':
          drawTimeMarker(cluster, time);
          break;
        case 'space':
          drawSpaceMarker(cluster);
          break;
        case 'embodiment':
          drawEmbodimentMarker(cluster);
          break;
      }
    }

    function render(now) {
      const time = now * 0.00045;
      updateClusters(time);

      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < clusters.length; i++) drawClusterHalo(clusters[i]);
      for (let i = 0; i < BRIDGES.length; i++) drawBridge(BRIDGES[i]);
      for (let i = 0; i < clusters.length; i++) drawIdleMesh(clusters[i]);
      for (let i = 0; i < clusters.length; i++) drawMarker(clusters[i], time);
      for (let i = 0; i < clusters.length; i++) drawNodes(clusters[i]);
      draw4DFieldHUD(time);
    }

    function step(now) {
      const frameInterval = isCompactViewport() ? 33 : 0; // ~30fps on mobile to save battery
      if (!frameInterval || now - lastFrameTime >= frameInterval) {
        lastFrameTime = now;
        render(now);
      }
      animationId = requestAnimationFrame(step);
    }

    function start() {
      if (reduceMotion) {
        render(performance.now());
        return;
      }
      if (animationId) return;
      animationId = requestAnimationFrame(step);
    }

    function stop() {
      if (!animationId) return;
      cancelAnimationFrame(animationId);
      animationId = 0;
    }

    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        resizeCanvas(false);
      }, 160);
    });

    if (typeof reduceMotionQuery.addEventListener === 'function') {
      reduceMotionQuery.addEventListener('change', onReducedMotionChange);
    } else if (typeof reduceMotionQuery.addListener === 'function') {
      reduceMotionQuery.addListener(onReducedMotionChange);
    }

    // Re-render static canvas when theme changes under reduced motion
    const themeObserver = new MutationObserver(() => {
      if (reduceMotion) render(performance.now());
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // 4D Spatial Field Pointer & Hold/Double-Click Handlers
    function isInteractiveElement(target) {
      if (!target || typeof target.closest !== 'function') return false;
      return Boolean(target.closest('a, button, input, textarea, select, summary, details, pre, code'));
    }

    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX;
      pointer.y = e.clientY;
      pointer.active = true;
    }, { passive: true });

    window.addEventListener('pointerdown', (e) => {
      pointer.x = e.clientX;
      pointer.y = e.clientY;
      pointer.active = true;
      if (e.button === 0 && !isInteractiveElement(e.target)) {
        pointer.holding = true;
      }
    }, { passive: true });

    window.addEventListener('pointerup', () => {
      pointer.holding = false;
    }, { passive: true });

    window.addEventListener('pointercancel', () => {
      pointer.holding = false;
    }, { passive: true });

    window.addEventListener('dblclick', (e) => {
      if (isInteractiveElement(e.target)) return;
      pointer.x = e.clientX;
      pointer.y = e.clientY;
      pointer.active = true;
      pointer.locked = !pointer.locked;
    });

    window['__toggle4DField'] = function (x, y) {
      pointer.x = typeof x === 'number' ? x : width * 0.62;
      pointer.y = typeof y === 'number' ? y : height * 0.42;
      pointer.active = true;
      pointer.locked = !pointer.locked;
      return pointer.locked;
    };

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    document.addEventListener('astro:after-swap', () => {
      resizeCanvas(false);
      start();
    });

    resizeCanvas(true);
    createClusters();
    start();
  })();
</script>
